        "import sys\n",
        "import os\n",
        "import torch\n",
        "import pytorch_lightning as pl\n",
        "from torch.utils.data import DataLoader, Subset\n",
        "import numpy as np\n",
        "import wandb\n",
        "from pytorch_lightning.loggers import WandbLogger\n",
        "from pytorch_lightning.callbacks import ModelCheckpoint, LearningRateMonitor\n",
        "\n",
        "sys.path.append('/content/')\n",
        "\n",
        "# Zaloguj się do WandB (wymaga klucza API z https://wandb.ai/authorize)\n",
        "wandb.login()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell-3"
      },
      "outputs": [],
      "source": [
        "from .datasets.dataset import PKLotDataset, collate_fn, get_transform\n",
        "from .models.custom_detector3 import SimpleUNetCenterNet\n",
        "from .models.lit_module import CenterNetLitModule\n",
        "\n",
        "def run_lightning_training():\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "    EPOCHS = 25\n",
        "    SUBSET_SIZE = 1000\n",
        "    VAL_SUBSET = 100\n",
        "\n",
        "    # 1. Przygotowanie danych\n",
        "    full_train_dataset = PKLotDataset(\n",
        "        root_dir=\"/content/data/raw/train\",\n",
        "        annotation_file=\"/content/data/raw/train/_annotations.coco.json\",\n",
        "        transforms=get_transform(is_train=True)\n",
        "    )\n",
        "    train_subset_size = min(SUBSET_SIZE, len(full_train_dataset))\n",
        "    train_indices = np.random.choice(len(full_train_dataset), train_subset_size, replace=False)\n",
        "    train_dataset = Subset(full_train_dataset, train_indices)\n",
        "\n",
        "    train_loader = DataLoader(\n",
        "        train_dataset,\n",
        "        batch_size=8,\n",
        "        shuffle=True,\n",
        "        num_workers=2,\n",
        "        collate_fn=collate_fn\n",
        "    )\n",
        "\n",
        "    full_val_dataset = PKLotDataset(\n",
        "        root_dir=\"/content/data/raw/valid\",\n",
        "        annotation_file=\"/content/data/raw/valid/_annotations.coco.json\",\n",
        "        transforms=get_transform(is_train=False)\n",
        "    )\n",
        "    val_subset_size = min(VAL_SUBSET, len(full_val_dataset))\n",
        "    val_indices = np.random.choice(len(full_val_dataset), val_subset_size, replace=False)\n",
        "    val_dataset = Subset(full_val_dataset, val_indices)\n",
        "\n",
        "    val_loader = DataLoader(\n",
        "        val_dataset,\n",
        "        batch_size=8,\n",
        "        shuffle=False,\n",
        "        num_workers=2,\n",
        "        collate_fn=collate_fn\n",
        "    )\n",
        "\n",
        "    # 2. Utworzenie modelu\n",
        "    base_model = SimpleUNetCenterNet(num_classes=2)\n",
        "    lit_model = CenterNetLitModule(model=base_model, lr=0.0003, epochs=EPOCHS)\n",
        "\n",
        "    # 3. Konfiguracja logowania (WandB) i callbacków\n",
        "    wandb_logger = WandbLogger(project=\"PKLot-CenterNet-Lightning\", name=\"run-v3-lightning\")\n",
        "    \n",
        "    os.makedirs('/content/checkpoints', exist_ok=True)\n",
        "    checkpoint_callback = ModelCheckpoint(\n",
        "        dirpath='/content/checkpoints/',\n",
        "        filename='centernet-epoch{epoch:02d}-val_loss{val/loss:.2f}',\n",
        "        auto_insert_metric_name=False,\n",
        "        monitor='val/loss',\n",
        "        mode='min',\n",
        "        save_top_k=3,\n",
        "        save_last=True\n",
        "    )\n",
        "    lr_monitor = LearningRateMonitor(logging_interval='epoch')\n",
        "\n",
        "    # 4. Inicjalizacja Trainera\n",
        "    trainer = pl.Trainer(\n",
        "        max_epochs=EPOCHS,\n",
        "        accelerator=\"auto\",\n",
        "        devices=1,\n",
        "        logger=wandb_logger,\n",
        "        callbacks=[checkpoint_callback, lr_monitor],\n",
        "        log_every_n_steps=10\n",
        "    )\n",
        "\n",
        "    # 5. Rozpoczęcie uczenia\n",
        "    trainer.fit(lit_model, train_loader, val_loader)\n",
        "    \n",
        "    # 6. Kopiowanie najlepszego modelu na Dysk Google\n",
        "    best_model_path = checkpoint_callback.best_model_path\n",
        "    if best_model_path:\n",
        "        print(f\"Najlepszy model zapisany pod: {best_model_path}\")\n",
        "        os.system(f'cp \"{best_model_path}\" /content/drive/MyDrive/NN_project/')\n",
        "    \n",
        "    wandb.finish()\n",
        "\n",
        "run_lightning_training()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell-4"
      },
      "outputs": [],
      "source": [
        "def evaluate_best_model():\n",
        "    # Pobierz ścieżkę do zapisanego checkpointu. Wpisz odpowiednią ścieżkę.\n",
        "    # np. '/content/checkpoints/last.ckpt'\n",
        "    ckpt_path = \"/content/checkpoints/last.ckpt\" \n",
        "    \n",
        "    if not os.path.exists(ckpt_path):\n",
        "        print(f\"Brak pliku checkpoint: {ckpt_path}\")\n",
        "        return\n",
        "\n",
        "    test_dataset = PKLotDataset(\n",
        "        root_dir=\"/content/data/raw/test\",\n",
        "        annotation_file=\"/content/data/raw/test/_annotations.coco.json\",\n",
        "        transforms=get_transform(is_train=False)\n",
        "    )\n",
        "\n",
        "    test_loader = DataLoader(\n",
        "        test_dataset,\n",
        "        batch_size=8,\n",
        "        shuffle=False,\n",
        "        num_workers=2,\n",
        "        collate_fn=collate_fn\n",
        "    )\n",
        "\n",
        "    base_model = SimpleUNetCenterNet(num_classes=2)\n",
        "    # Wczytanie modelu z ckpt\n",
        "    lit_model = CenterNetLitModule.load_from_checkpoint(ckpt_path, model=base_model)\n",
        "    \n",
        "    trainer = pl.Trainer(accelerator=\"auto\", devices=1)\n",
        "    \n",
        "    print(\"Rozpoczynam ewaluację na zbiorze testowym...\")\n",
        "    trainer.test(lit_model, dataloaders=test_loader)\n",
        "\n",
        "evaluate_best_model()"
      ]
    }
